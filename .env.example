# Copy to .env and fill in. NEVER commit the real .env.

# --- Enable Banking (covers all banks, including Wise) ---
# Application id from the Enable Banking control panel.
EB_APP_ID=
# Path to the RSA private key (PEM) paired with the certificate registered in Enable Banking.
EB_PRIVATE_KEY=./eb_private_key.pem

# Optional, and usually better left empty. Your public IP is sent as the Psu-Ip-Address header
# so user-triggered fetches count as "online" requests, which banks rate-limit far less than
# background ones (typically 4x/day). It is detected automatically across several lookup
# services, and the detected value WINS over this one — on a dynamic address a pinned value is
# stale within a day, so overriding detection with it would make the header confidently wrong.
# Set this only if your address is static, or as a fallback for when every lookup fails.
EB_PSU_IP=
